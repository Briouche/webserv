server {
    listen 8080;
    host 127.0.0.1;
    server_name myserver;
    root ./root;
    client_max_body_size 1000;

	error_page 404 ./root/errors/error404.html;
	error_page 504 ./root/errors/error504.html;

	location / {
		autoindex on;
		allowed_methods GET;
		root ./root;
		index index.html;
		upload_path ./root/uploads;
	}

    location /html {
		autoindex on;
		allowed_methods GET POST;
		root ./root;
		index index.html;
		upload_path ./root/uploads;
	}

    location /images {
        autoindex on;
        allowed_methods GET POST;
        root ./root;
        index index.html;
		upload_path ./root/uploads;
    }

    location /uploads {
        autoindex on;
        allowed_methods GET POST DELETE;
		upload_path ./root/uploads;
    }

    location /cgi-bin {
        autoindex on;
        allowed_methods GET POST;
        root ./root;
        cgi_pass .php /usr/bin/php-cgi;
		cgi_pass .py /usr/bin/python3;
    }

	location /srcs {
		redirect 301 ../index.html;
		allowed_methods GET;
	}
}
