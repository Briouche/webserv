server {
    listen 9090;
    host 127.0.0.1;
    server_name myserver;
    root ./root;
    client_max_body_size 1000;

	error_page 404 ./root/errors/error404.html;
	error_page 504 ./root/errors/error504.html;

	location / {
		autoindex on;
		allowed_methods GET POST;
		root ./root/html;
		index index.html;
		upload_path ./root/uploads;
	}

    location /html {
		autoindex on;
		allowed_methods GET POST;
		root ./root/html;
		index index.html;
		upload_path ./root/uploads;
	}

    location /images {
        autoindex on;
        allowed_methods GET POST;
        root ./root/images;
        index index.html;
		upload_path ./uploads;
    }

    location /uploads {
        autoindex on;
        allowed_methods GET POST DELETE;
		upload_path ./root/uploads;
    }

    location /cgi-bin {
        autoindex on;
        allowed_methods GET POST;
        root ./cgi-bin;
        cgi_pass .php /usr/bin/php-cgi;
		cgi_pass .py /usr/bin/python3;
    }

	location /srcs {
		redirect 301 ../root/index.html;
		allowed_methods GET POST;
	}
}

server {
    listen					8081;
    server_name				localhost;
    root        			./root;
    client_max_body_size 	1000;

    location / {
        allowed_methods     GET POST;
        autoindex   		on;
		index       		index.html;
    }

    location /uploads {
        allowed_methods     POST;
        upload_path  		./root/uploads;
    }

    location /cgi-bin {
        autoindex 			on;
        allowed_methods 	GET POST;
        root 				./cgi-bin;
        cgi_pass 			.php /usr/bin/php-cgi;
		cgi_pass 			.py /usr/bin/python3;
    }

    error_page				404 /errors/error404.html;
}

